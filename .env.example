# Copy to .env to override the defaults used in docker-compose.yml.
# Change the passwords before the first start: they are set when the database is created
# (role passwords are re-applied by omop-init on every start).

# Postgres superuser
POSTGRES_PASSWORD=postgres

# OMOP vocabulary package (zip with the Athena CSV files), only downloaded on the first start
VOCAB_URL=https://surfdrive.surf.nl/s/syJN2z2XaR5eMmM/download

# OHDSI Data Quality Dashboard
DQD_PASSWORD=dqd
DQD_THREADS=2
# Cron expression (UTC) for the scheduled DQD runs
DQD_SCHEDULE=0 2 * * *
DQD_RUN_ON_START=true

# Superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_DB_PASSWORD=superset
SUPERSET_READER_PASSWORD=superset_reader
# Generated and stored in the superset_home volume when empty
SUPERSET_SECRET_KEY=

# Uncomment to also seed the Eunomia GiBleed demo data
#COMPOSE_PROFILES=demo
